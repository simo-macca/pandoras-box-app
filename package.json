{
  "name": "pandoras-box-app",
  "private": true,
  "version": "1.2.1",
  "description": "Unofficial, offline-first companion app and scorekeeper for the card games Frantic and Pandora's Box by Rulefactory.",
  "license": "MIT",
  "author": "Simone Maccario",
  "homepage": "https://github.com/simo-macca/pandoras-box-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simo-macca/pandoras-box-app.git"
  },
  "bugs": {
    "url": "https://github.com/simo-macca/pandoras-box-app/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:md": "prettier --write \"**/*.md\" && markdownlint-cli2 --fix",
    "prepare": "husky",
    "validate": "npm run type-check && npm run lint && npm run lint:md && npm run format:check && npm run test"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
